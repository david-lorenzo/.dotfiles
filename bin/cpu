#!/usr/bin/sh

if [ "$1" = "slow" ]
then
	cpu fast
	sudo /usr/bin/cpufreq-set -g powersave -u 1000MHz -c 0
	sudo /usr/bin/cpufreq-set -g powersave -u 1000MHz -c 1
	sudo /usr/bin/cpufreq-set -g powersave -u 1000MHz -c 2
	sudo /usr/bin/cpufreq-set -g powersave -u 1000MHz -c 3
fi

if [ "$1" = "fast" ]
then
	sudo /usr/bin/cpufreq-set -g ondemand -u 3200MHz -c 0
	sudo /usr/bin/cpufreq-set -g ondemand -u 3200MHz -c 1
	sudo /usr/bin/cpufreq-set -g ondemand -u 3200MHz -c 2
	sudo /usr/bin/cpufreq-set -g ondemand -u 3200MHz -c 3
fi

exit 0
